# Supabase — find these in: Project Settings > API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-or-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-or-secret-key
# NOTE: SUPABASE_JWT_SECRET is intentionally not required — JWT verification
# uses Supabase's JWKS endpoint so no shared secret is needed.

# Google Gemini API
GEMINI_API_KEY=your-gemini-api-key

# CORE API (core.ac.uk — open-access paper aggregator, used by self-study library)
CORE_API_KEY=your-core-api-key

# Backend CORS — comma-separated list of allowed frontend origins
# (production must set this to your real frontend URL)
ALLOWED_ORIGINS=http://localhost:3000
ENVIRONMENT=development

# Frontend env vars (VITE_SUPABASE_URL, VITE_SUPABASE_ANON_KEY, VITE_API_URL)
# live in frontend/.env.example — copy that one to frontend/.env.local.
